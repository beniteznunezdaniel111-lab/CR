# =============================================================================
# HRPilot — variables de entorno
# Copia este fichero a .env.local (desarrollo) o configúralas en Vercel.
# En local, `pnpm env:local` rellena las de Supabase automáticamente.
# NUNCA subas claves reales a git.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
# URL pública de la app (enlaces de invitación y emails de Supabase Auth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Código que se pide al registrarse durante la validación. Vacío = registro libre.
# Quien llega con una invitación válida no lo necesita. En producción usa un
# código largo y aleatorio (p. ej. `openssl rand -base64 18`): no hay límite de intentos.
SIGNUP_ACCESS_CODE=

# --- Supabase ----------------------------------------------------------------
# Proyecto en región UE. Panel de Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (sb_publishable_…) o la antigua anon key. Es pública.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…) o la antigua service_role key. SOLO servidor:
# se salta RLS; se usa únicamente para auditoría, uso de IA, cron y scripts.
SUPABASE_SECRET_KEY=
# Conexión directa a Postgres (solo tests de base de datos y scripts).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- IA (Anthropic) ----------------------------------------------------------
# anthropic = llamadas reales · mock = respuestas fijas sin coste (tests, CI, demos)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Modelo por defecto (decisión del MVP): Claude Haiku 5.5.
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Embeddings de la FAQ (Voyage AI) ------------------------------------------
# Búsqueda semántica de los documentos de la FAQ. Sin clave se usa un modo básico
# (mock) que solo encuentra coincidencias de palabras: funciona, pero peor.
# Requiere permitir api.voyageai.com en la red del entorno.
# voyage | mock (vacío = voyage si hay clave, mock si no)
EMBEDDINGS_PROVIDER=
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Similitud mínima (0-1) para considerar relevante un fragmento. Vacío = 0.4 con
# Voyage. Súbela si responde con fragmentos poco relacionados; bájala si dice
# demasiado a menudo que no encuentra la respuesta.
FAQ_MIN_SIMILARITY=

# --- Email (SMTP) --------------------------------------------------------------
# Para enviar invitaciones (Brevo, Resend...). Sin SMTP, la app muestra el enlace
# para copiarlo. En local, Supabase expone un buzón de pruebas en 127.0.0.1:54325
# (bandeja visible en http://127.0.0.1:54324).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HRPilot <no-reply@tu-dominio.com>"

# --- Tareas programadas (Fase 2) ----------------------------------------------
# Secreto que Vercel Cron envía para autorizar /api/cron/* (p. ej. el borrado
# diario de CVs caducados, programado en vercel.json). Sin él, el cron no hace nada.
# Genera uno largo y aleatorio: openssl rand -hex 32
CRON_SECRET=

# --- Seed de demo ---------------------------------------------------------------
# Contraseña de las cuentas demo creadas por `pnpm db:seed` (solo desarrollo).
SEED_PASSWORD=Demo1234
